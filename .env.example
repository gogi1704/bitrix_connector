APP_HOST=0.0.0.0
APP_PORT=8000
CONNECTOR_HOST_PORT=8001
PUBLIC_BASE_URL=https://connector.example.com

CLIENT_ID=local.xxxxxxxxx
CLIENT_SECRET=replace_me
BITRIX_DOMAIN=example.bitrix24.ru
BITRIX_ACCESS_TOKEN=
# Не используется уведомлениями об оплате; нужен только для Открытых линий.
# BITRIX_OPENLINE_ID=17
# Generate these two values independently with: openssl rand -hex 32
BITRIX_INSTALL_TOKEN=replace_with_random_hex
CONNECTOR_ADMIN_TOKEN=replace_me
# Shared only with Consilium. Generate independently with: openssl rand -hex 32
CONSILIUM_PAYMENT_SECRET=replace_with_random_hex
# Destination chat: chat123, group/project chat: sg123, or a user ID.
BITRIX_PAYMENT_DIALOG_ID=

JOB_MAX_ATTEMPTS=8
JOB_POLL_SECONDS=0.5
JOB_FAILED_RETENTION_DAYS=7
JOB_COMPLETED_RETENTION_DAYS=30

# Normally empty: Bitrix24 sends application_token during installation and
# the connector stores it in storage/oauth.json automatically.
# BITRIX_APPLICATION_TOKEN=

# Интеграция с MAX не используется уведомлениями об оплате.
# MAX_API_URL=https://platform-api2.max.ru
# MAX_BOT_TOKEN=replace_me
# MAX_WEBHOOK_SECRET=replace_me
# MAX_CONNECTOR_ID=max_bot_bridge

# Existing read-only service-account keys from anketa_bot_max.
# ANKETA_BOT_MAX_DOCS_DIR=../anketa_bot_max/docs
# ANKETA_GOOGLE_CREDENTIALS=/external/anketa_bot_max/docs/anamnez-max-a04dd6899274.json
# AFTER_TESTS_GOOGLE_CREDENTIALS=/external/anketa_bot_max/docs/after-tests-db-e0cd34372c4a.json
# ANKETA_GOOGLE_SPREADSHEET_NAME=anamnez_db_max
# AFTER_TESTS_GOOGLE_SPREADSHEET_NAME=after_tests_db


# Параметры медиа нужны только мосту MAX ↔ Битрикс24.
# MEDIA_MAX_BYTES=52428800
# MEDIA_DOWNLOAD_TIMEOUT=120

# Напоминания менеджера и автообновление защищённой панели /analytics/.
# REMINDER_MAX_DAYS=365
# ANALYTICS_REFRESH_SECONDS=60

# ИИ-анализ один раз после 30 минут тишины в диалоге.
# FOLLOWUP_ENABLED=true
# FOLLOWUP_DELAY_MINUTES=30
# FOLLOWUP_NEXT_DAY_HOUR=9
# FOLLOWUP_TIMEZONE=Europe/Moscow
# FOLLOWUP_QUIET_START_HOUR=21
# FOLLOWUP_QUIET_END_HOUR=9
# FOLLOWUP_MAX_CONTEXT_MESSAGES=20

# ИИ необязателен: без него используются консервативные бизнес-правила.
# При включении фрагмент переписки передаётся выбранному API после удаления
# телефонов и email. Убедитесь, что это соответствует вашей политике данных.
# FOLLOWUP_AI_ENABLED=false
# FOLLOWUP_AI_API_KEY=
# FOLLOWUP_AI_BASE_URL=https://api.openai.com/v1
# FOLLOWUP_AI_MODEL=gpt-5-mini
# FOLLOWUP_AI_TIMEOUT=30

# ИИ включается автоматически, если указан SUMMARY_AI_API_KEY или
# FOLLOWUP_AI_API_KEY. Для принудительного отключения: SUMMARY_AI_ENABLED=false
# SUMMARY_AI_API_KEY=
# SUMMARY_AI_BASE_URL=
# SUMMARY_AI_MODEL=
# SUMMARY_AI_TIMEOUT=60
# SUMMARY_AI_MAX_INPUT_CHARS=24000
# SUMMARY_AI_MAX_OUTPUT_TOKENS=1200
# SUMMARY_AI_CONCURRENCY=2
