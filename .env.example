MAX_BOT_TOKEN=replace_me
MAX_WEBHOOK_SECRET=replace_me
MAX_CONNECTOR_ID=max_bot_bridge

# Existing read-only service-account keys from anketa_bot_max.
ANKETA_BOT_MAX_DOCS_DIR=../anketa_bot_max/docs
ANKETA_GOOGLE_CREDENTIALS=/external/anketa_bot_max/docs/anamnez-max-a04dd6899274.json
